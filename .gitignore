# ----------------------------------------------------------------------
# Specific to your project
# ----------------------------------------------------------------------

# Data files – raw and processed data (often large, not for repo)
data/raw/
data/processed/
data/external/

# Generated reports and charts (can be regenerated)
reports/
*.docx
*.pdf
*.png
*.jpg
*.jpeg
*.html

# Static generated files (if your app generates charts/images)
app/static/*.png
app/static/*.jpg
app/static/*.jpeg
!app/static/.gitkeep   # keep the folder if needed

# Logs
*.log

# OS metadata
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Temporary files
tmp/
temp/
*.tmp

# Secret / sensitive files
*.key
*.pem
*.crt
*.p12
.secrets
config.ini
credentials.json
client_secret*.json

# ----------------------------------------------------------------------
# Keep the directory structure with .gitkeep if needed
